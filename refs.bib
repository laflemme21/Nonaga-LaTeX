"@article{browne2014bitboards,
author = {Cameron Browne},
title ={Bitboard Methods for Games},

journal = {ICGA Journal},
volume = {37},
number = {2},
pages = {67-84},
year = {2014},
doi = {10.3233/ICG-2014-37202},

URL = { 
    
    
